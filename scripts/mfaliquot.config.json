"logging": {
    "version": 1,
    "log_dir": "../log",
    "disable_existing_loggers": false,

    "formatters": {
        "main": {
            "datefmt": "%H:%M:%S",
            "format": "%(asctime)s %(levelname)s %(name)s:%(lineno)d: %(message)s"
        }
    },

    "handlers": {
        "file_handler": {
            "level": "INFO",
            "formatter": "main",
            "class": "logging.handlers.TimedRotatingFileHandler",
            "filename": "{logging[log_dir]}/{{}}.log",
            "when": "W6"
        },
        "console_handler": {
            "level": "DEBUG",
            "formatter": "main",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout"
        },
        "email_handler": {
            "level": "ERROR",
            "formatter": "main",
            "()": "mfaliquot.BufferingSMTPHandler",
            "host": "localhost",
            "username": "",
            "password": "",
            "from_addr": "technik@rechenkraft.net",
            "to_addrs": ["technik@rechenkraft.net"],
            "scriptname": "{{}}"
        }
    },

    "root": {
        "level": "DEBUG",
        "handlers": ["file_handler", "console_handler", "email_handler"]
    }
}
